{
  "name": "aurora",
  "version": "0.1.0",
  "private": true,
  "description": "Aurora - plataforma de periodicos cientificos da New Science Publishers",
  "scripts": {
    "dev": "next dev -p 4321",
    "build": "next build",
    "start": "next start -p 4321",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "harvest:oai": "node scripts/harvest-oai.mjs",
    "harvest:crossref": "node scripts/harvest-crossref.mjs",
    "import": "node scripts/import.mjs",
    "pipeline": "npm run harvest:oai && npm run harvest:crossref && npm run import && npm run seed && npm run enriquecer && npm run sync:indexadores",
    "seed": "node scripts/seed-conteudo.mjs",
    "sync:indexadores": "node scripts/sync-indexadores.mjs",
    "enriquecer": "node scripts/enriquecer-openalex.mjs",
    "atualizar": "npm run harvest:crossref && npm run enriquecer && npm run sync:indexadores",
    "build:netlify": "prisma generate && next build",
    "postinstall": "prisma generate",
    "db:deploy": "prisma db push --accept-data-loss",
    "local:sqlite": "node scripts/banco.mjs sqlite",
    "local:postgres": "node scripts/banco.mjs postgres",
    "producao": "node scripts/configurar-producao.mjs",
    "exemplo:citacoes": "node scripts/exemplo-citacoes.mjs"
  },
  "dependencies": {
    "@netlify/blobs": "11.1.10",
    "@prisma/client": "6.1.0",
    "fast-xml-parser": "4.5.1",
    "next": "15.1.6",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "prisma": "6.1.0",
    "typescript": "5.7.3"
  }
}
